# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/empresafacil

# Servidor
PORT=3333
HOST=0.0.0.0
BACKEND_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173
SYNC_PULL_LIMIT=500

# JWT — gere um segredo forte em produção: openssl rand -base64 32
JWT_SECRET=troque-este-valor-em-producao

# OAuth: Google
# Crie em: https://console.cloud.google.com → APIs e Serviços → Credenciais
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth: Microsoft
# Crie em: https://portal.azure.com → Microsoft Entra ID → Registros de aplicativo
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email (SMTP) — deixe vazio para imprimir os links no console (modo dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EmpresaFácil <noreply@empresafacil.app>
